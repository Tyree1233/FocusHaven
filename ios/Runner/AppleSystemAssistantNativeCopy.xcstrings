{
  "sourceLanguage": "en",
  "strings": {
    "appleSystemAssistantNativeCancelledResult": {
      "comment": "Truthful native cancellation result that explicitly denies timer or queue mutation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request cancelled. FocusHaven did not change your timer or queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud cancelada. FocusHaven no modificó su temporizador ni su cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requête annulée. FocusHaven n'a pas modifié votre minuteur ni votre file d'attente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage abgebrochen. FocusHaven hat weder Ihren Timer noch Ihre Warteschlange geändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitação cancelada. O FocusHaven não alterou seu temporizador nem sua fila."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitação cancelada. O FocusHaven não alterou seu temporizador nem sua fila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストはキャンセルされました。FocusHavenはタイマーやキューを変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 취소되었습니다. FocusHaven은 타이머나 대기열을 변경하지 않았습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta annullata. FocusHaven non ha modificato il timer o la coda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośba anulowana. FocusHaven nie zmienił Twojego timera ani kolejki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoek geannuleerd. FocusHaven heeft uw timer of wachtrij niet gewijzigd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan dibatalkan. FocusHaven tidak mengubah pengatur waktu atau antrean Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek iptal edildi. FocusHaven zamanlayıcınızda veya sıranızda herhangi bir değişiklik yapmadı."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begäran avbröts. FocusHaven ändrade inte din timer eller kö."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forespørselen ble avbrutt. FocusHaven endret ikke timeren eller køen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmodning annulleret. FocusHaven ændrede ikke din timer eller kø."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyntö peruttu. FocusHaven ei muuttanut ajastinta tai jonoa."
          }
        }
      }
    },
