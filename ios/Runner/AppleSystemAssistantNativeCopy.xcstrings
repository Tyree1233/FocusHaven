          "stringUnit": {
            "state": "translated",
            "value": "FocusHavenを開き、正確な効果を確認してから、「アクションを確認する」または「リクエストを無視する」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven을 열고 정확한 효과를 확인한 다음, 작업 확인 또는 요청 해제를 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri FocusHaven, verifica l'effetto esatto, quindi scegli Conferma azione o Ignora richiesta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz FocusHaven, sprawdź dokładny efekt, a następnie wybierz opcję Potwierdź akcję lub Zignoruj prośbę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open FocusHaven, bekijk het exacte effect en kies vervolgens 'Actie bevestigen' of 'Verzoek negeren'."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka FocusHaven, tinjau efek pastinya, lalu pilih Konfirmasi tindakan atau Abaikan permintaan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven'ı açın, tam etkiyi inceleyin, ardından İşlemi onaylayın veya İsteği yoksay seçeneklerinden birini seçin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna FocusHaven, granska den exakta effekten och välj sedan Bekräfta åtgärd eller Ignorera begäran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne FocusHaven, se gjennom den nøyaktige effekten, og velg deretter Bekreft handling eller Ignorer forespørsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn FocusHaven, gennemgå den nøjagtige effekt, og vælg derefter Bekræft handling eller Ignorer anmodning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa FocusHaven, tarkista tarkka vaikutus ja valitse sitten Vahvista toiminto tai Ohita pyyntö."
          }
        }
      }
    },
    "appleSystemAssistantNativeReviewRequiredAccessibilityLabel": {
      "comment": "Complete VoiceOver label for a native handoff that is waiting for explicit in-app review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven request ready for review. No action has run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de FocusHaven está lista para su revisión. No se ha realizado ninguna acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête FocusHaven est prête à être examinée. Aucune action n'a été exécutée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die FocusHaven-Anfrage ist zur Überprüfung bereit. Es wurden noch keine Aktionen ausgeführt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação da FocusHaven está pronta para análise. Nenhuma ação foi executada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação da FocusHaven está pronta para análise. Nenhuma ação foi executada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHavenのリクエストは審査準備完了です。アクションはまだ実行されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven 요청이 검토 준비를 완료했습니다. 아직 실행된 작업이 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta FocusHaven pronta per la revisione. Nessuna azione è stata eseguita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośba FocusHaven jest gotowa do rozpatrzenia. Nie wykonano żadnej akcji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het FocusHaven-verzoek is klaar voor beoordeling. Er is nog geen actie ondernomen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan FocusHaven siap untuk ditinjau. Belum ada tindakan yang dijalankan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven isteği incelemeye hazır. Henüz hiçbir işlem gerçekleştirilmedi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven-förfrågan är klar för granskning. Ingen åtgärd har utförts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven-forespørselen er klar til gjennomgang. Ingen handling er utført."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven-anmodning er klar til gennemgang. Der er ikke udført nogen handling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHavenin pyyntö on valmis tarkistettavaksi. Mitään toimia ei ole suoritettu."
          }
        }
      }
    },
