    "appleSystemAssistantNativeOpenFocusQueueTitle": {
      "comment": "Short native title for preparing the open-Focus-Queue request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Focus Queue"
          }
        },
