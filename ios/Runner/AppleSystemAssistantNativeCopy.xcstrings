    "appleSystemAssistantNativePendingRequestResult": {
      "comment": "Truthful native result when the single process-memory request slot is already occupied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven already has a request waiting. Open the app to review or dismiss it before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven ya tiene una solicitud pendiente. Abre la aplicación para revisarla o descartarla antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven a déjà une requête en attente. Ouvrez l'application pour la consulter ou l'ignorer avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven hat bereits eine Anfrage. Öffnen Sie die App, um sie zu überprüfen oder zu verwerfen, bevor Sie es erneut versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FocusHaven já tem uma solicitação em espera. Abra o aplicativo para analisá-la ou descartá-la antes de tentar novamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O FocusHaven já tem uma solicitação em espera. Abra o aplicativo para analisá-la ou descartá-la antes de tentar novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHavenには既にリクエストが届いています。アプリを開いて内容を確認するか無視してから、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven에는 이미 대기 중인 요청이 있습니다. 앱을 열어 요청을 확인하거나 해제한 후 다시 시도하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven ha già una richiesta in sospeso. Apri l'app per esaminarla o ignorarla prima di riprovare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven ma już oczekującą prośbę. Otwórz aplikację, aby ją przejrzeć lub zignorować, a następnie spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven heeft al een verzoek in behandeling. Open de app om het verzoek te bekijken of te negeren voordat u het opnieuw probeert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven sudah memiliki permintaan yang menunggu. Buka aplikasi untuk meninjau atau mengabaikannya sebelum mencoba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven'da halihazırda bekleyen bir istek var. Tekrar denemeden önce incelemek veya yoksaymak için uygulamayı açın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven har redan en väntande förfrågan. Öppna appen för att granska eller ignorera den innan du försöker igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven har allerede en forespørsel som venter. Åpne appen for å se gjennom den eller ignorere den før du prøver på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven har allerede en ventende anmodning. Åbn appen for at gennemgå den, eller ignorere den, før du prøver igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven on jo odottava pyyntö. Avaa sovellus tarkistaaksesi tai ohittaaksesi sen ennen kuin yrität uudelleen."
          }
        }
      }
    },
    "appleSystemAssistantNativePrivacySummary": {
      "comment": "Native privacy summary for the exact text-free Apple-to-FocusHaven request boundary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the action type and a private request code enter FocusHaven. No transcript or private content is included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el tipo de acción y un código de solicitud privado ingresan a FocusHaven. No se incluye ninguna transcripción ni contenido privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls le type d'action et un code de requête privé sont transmis à FocusHaven. Aucune transcription ni contenu privé n'est inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lediglich der Aktionstyp und ein privater Anforderungscode gelangen in FocusHaven. Es werden weder Transkripte noch private Inhalte übermittelt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o tipo de ação e um código de solicitação privado são inseridos no FocusHaven. Nenhuma transcrição ou conteúdo privado é incluído."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o tipo de ação e um código de solicitação privado são inseridos no FocusHaven. Nenhuma transcrição ou conteúdo privado é incluído."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHavenには、アクションの種類とプライベートリクエストコードのみが送信されます。文字起こしやプライベートコンテンツは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven에는 작업 유형과 비공개 요청 코드만 입력됩니다. 녹취록이나 비공개 콘텐츠는 포함되지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A FocusHaven vengono inviati solo il tipo di azione e un codice di richiesta privato. Non vengono incluse trascrizioni o contenuti privati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do FocusHaven wprowadzany jest tylko typ akcji i prywatny kod prośby. Transkrypcja ani prywatna treść nie jest uwzględniana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven ontvangt alleen het actietype en een privéverzoekcode. Er wordt geen transcript of privé-inhoud meegestuurd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jenis tindakan dan kode permintaan pribadi yang masuk ke FocusHaven. Tidak ada transkrip atau konten pribadi yang disertakan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven'a yalnızca işlem türü ve özel istek kodu girilir. Transkript veya özel içerik dahil edilmez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast åtgärdstypen och en privat förfrågningskod anges i FocusHaven. Inget transkript eller privat innehåll inkluderas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare handlingstypen og en privat forespørselskode går inn i FocusHaven. Ingen transkripsjon eller privat innhold er inkludert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun handlingstypen og en privat anmodningskode indtastes i FocusHaven. Ingen transskription eller privat indhold er inkluderet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain toimintotyyppi ja yksityinen pyyntökoodi syötetään FocusHaven. Transkriptiä tai yksityistä sisältöä ei sisällytetä."
          }
        }
      }
    },
    "appleSystemAssistantNativeReadTimerStatusDescription": {
      "comment": "Complete native description for the read-timer-status route without claiming the status has been read.",
      "extractionState": "manual",
      "localizations": {
