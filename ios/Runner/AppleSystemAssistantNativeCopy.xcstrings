    "appleSystemAssistantNativeStartFocusTimerDescription": {
      "comment": "Complete native description for starting only the ready Focus session after in-app review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare a request to review starting the ready Focus session in FocusHaven."
          }
        },
        "es": {
