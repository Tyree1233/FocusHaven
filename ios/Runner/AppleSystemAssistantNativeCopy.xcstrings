    "appleSystemAssistantNativeDiscoveryDescription": {
      "comment": "Discovery description stating that a native request is prepared for later in-app review rather than executed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare a supported FocusHaven request for review in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare una solicitud de FocusHaven compatible para su revisión en la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez une demande FocusHaven prise en charge pour examen dans l'application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereiten Sie eine unterstützte FocusHaven-Anfrage zur Überprüfung in der App vor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare uma solicitação FocusHaven compatível para análise no aplicativo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare uma solicitação FocusHaven compatível para análise no aplicativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内で審査を受けるための、サポート対象のFocusHavenリクエストを準備してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 검토할 수 있도록 지원되는 FocusHaven 요청을 준비하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara una richiesta FocusHaven supportata per la revisione nell'app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotuj obsługiwaną prośbę FocusHaven do przejrzenia w aplikacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereid een ondersteund FocusHaven-verzoek voor ter beoordeling in de app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapkan permintaan FocusHaven yang didukung untuk ditinjau di dalam aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada incelenmek üzere desteklenen bir FocusHaven talebi hazırlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered en FocusHaven-förfrågan som stöds för granskning i appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbered en støttet FocusHaven-forespørsel for gjennomgang i appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbered en understøttet FocusHaven-anmodning til gennemgang i appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistele tuettu FocusHavenin pyyntö tarkistettavaksi sovelluksessa."
          }
        }
      }
    },
    "appleSystemAssistantNativeExpiredResult": {
      "comment": "Truthful expiration result for a request that never received in-app confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request expired before confirmation. FocusHaven did not change your timer or queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud caducó antes de ser confirmada. FocusHaven no modificó su temporizador ni su cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette requête a expiré avant confirmation. FocusHaven n'a pas modifié votre minuteur ni votre file d'attente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage ist vor der Bestätigung abgelaufen. FocusHaven hat weder Ihren Timer noch Ihre Warteschlange geändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitação expirou antes da confirmação. O FocusHaven não alterou seu temporizador ou fila."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitação expirou antes da confirmação. O FocusHaven não alterou seu temporizador ou fila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストは確認前に期限切れとなりました。FocusHavenはタイマーやキューを変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 확인 전에 만료되었습니다. FocusHaven은 타이머나 대기열을 변경하지 않았습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta è scaduta prima della conferma. FocusHaven non ha modificato il timer o la coda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba wygasła przed potwierdzeniem. FocusHaven nie zmienił Twojego timera ani kolejki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek is verlopen voordat het bevestigd kon worden. FocusHaven heeft uw timer of wachtrij niet gewijzigd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ini kedaluwarsa sebelum dikonfirmasi. FocusHaven tidak mengubah pengatur waktu atau antrean Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek onaylanmadan önce süresi doldu. FocusHaven zamanlayıcınızı veya sıranızı değiştirmedi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna begäran upphörde att gälla innan bekräftelse. FocusHaven ändrade inte din timer eller kö."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne forespørselen utløp før bekreftelse. FocusHaven endret ikke timeren eller køen din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne anmodning udløb før bekræftelse. FocusHaven ændrede ikke din timer eller kø."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä pyyntö vanheni ennen vahvistusta. FocusHaven ei muuttanut ajastinta tai jonoa."
          }
        }
      }
    },
    "appleSystemAssistantNativeNoParametersSummary": {
      "comment": "Disclosure that the five supported native routes accept no free-form or action-specific parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time, task, or queue details can be added to this request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden añadir detalles de tiempo, tarea o cola a esta solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est impossible d'ajouter des détails concernant l'heure, la tâche ou la file d'attente à cette requête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anfrage können keine Zeit-, Aufgaben- oder Warteschlangendetails hinzugefügt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível adicionar detalhes de tempo, tarefa ou fila a esta solicitação."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível adicionar detalhes de tempo, tarefa ou fila a esta solicitação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストには、時間、タスク、キューの詳細を追加することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청에는 시간, 작업 또는 대기열 세부 정보를 추가할 수 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile aggiungere dettagli relativi a orari, attività o code a questa richiesta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tej prośby nie można dodać szczegółów dotyczących czasu, zadania ani kolejki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan dit verzoek kunnen geen tijds-, taak- of wachtrijdetails worden toegevoegd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada detail waktu, tugas, atau antrian yang dapat ditambahkan ke permintaan ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu isteğe zaman, görev veya sıra bilgisi eklenemez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tid, uppgift eller köinformation kan läggas till i den här begäran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen detaljer om tid, oppgave eller kø kan legges til denne forespørselen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kan ikke tilføjes oplysninger om tid, opgave eller kø til denne anmodning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän pyyntöön ei voi lisätä aikaa, tehtävää tai jonoa koskevia tietoja."
          }
        }
      }
    },
    "appleSystemAssistantNativeOpenFocusQueueDescription": {
      "comment": "Complete native description for opening Focus Queue only after in-app review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare a request to review opening Focus Queue in FocusHaven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare una solicitud para revisar la apertura de la cola de enfoque en FocusHaven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez une demande d'examen de l'ouverture de la file d'attente de concentration dans FocusHaven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereiten Sie eine Anfrage zur Überprüfung des Öffnens der Fokus-Warteschlange in FocusHaven vor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare uma solicitação para revisar a abertura da fila de foco no FocusHaven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare uma solicitação para revisar a abertura da fila de foco no FocusHaven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHavenでフォーカスキューを開くためのレビュー依頼を準備してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven에서 포커스 큐를 열기 위한 검토 요청을 준비하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara una richiesta di revisione per l'apertura della coda Focus in FocusHaven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotuj prośbę o rozpatrzenie możliwości otwarcia kolejki skupienia w FocusHaven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereid een verzoek voor om de opening van de Focus-wachtrij in FocusHaven te laten beoordelen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapkan permintaan untuk meninjau pembukaan Antrian Fokus di FocusHaven."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusHaven'da Odak Kuyruğu'nun açılmasını incelemek için bir talep hazırlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered en begäran om att granska öppningen av fokuskön i FocusHaven."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbered en forespørsel om å gjennomgå åpningen av fokuskøen i FocusHaven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbered en anmodning om at gennemgå åbningen af fokuskø i FocusHaven."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadi pyyntö FocusHavenissa avattavan keskittymisjonon tarkistamiseksi."
          }
        }
      }
    },
