          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered en begäran om att granska starten av den färdiga fokussessionen i FocusHaven."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbered en forespørsel om å gjennomgå oppstart av den klare fokusøkten i FocusHaven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbered en anmodning om at gennemgå starten af den klargjorte fokussession i FocusHaven."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistele pyyntö FocusHavenissa olevan valmiin keskittymisistunnon aloittamiseksi."
          }
        }
      }
