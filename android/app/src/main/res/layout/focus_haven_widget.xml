<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_haven_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/focus_haven_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/focus_haven_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/focus_haven_widget_name"
        android:textColor="@color/focus_haven_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/focus_haven_widget_session"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/focus_haven_widget_focus"
        android:textColor="@color/focus_haven_widget_foreground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/focus_haven_widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25:00"
            android:textColor="@color/focus_haven_widget_foreground"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/focus_haven_widget_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/focus_haven_widget_foreground"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/focus_haven_widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/focus_haven_widget_ready"
        android:textColor="@color/focus_haven_widget_muted"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/focus_haven_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="1500"
        android:progress="0"
        android:progressBackgroundTint="@color/focus_haven_widget_progress_track"
        android:progressTint="@color/focus_haven_widget_accent" />

    <LinearLayout
        android:id="@+id/focus_haven_widget_controls"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/focus_haven_widget_reset_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/focus_haven_widget_reset"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/focus_haven_widget_primary_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/focus_haven_widget_start"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
