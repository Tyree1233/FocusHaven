<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_haven_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/focus_haven_widget_background"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/focus_haven_widget_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/focus_haven_widget_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:text="@string/focus_haven_widget_focus"
            android:textColor="@color/focus_haven_widget_foreground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/focus_haven_widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/focus_haven_widget_default_time"
                android:textColor="@color/focus_haven_widget_foreground"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/focus_haven_widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:textColor="@color/focus_haven_widget_foreground"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/focus_haven_widget_status"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/focus_haven_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:indeterminate="false"
        android:importantForAccessibility="no"
        android:max="1500"
        android:progress="0"
        android:progressBackgroundTint="@color/focus_haven_widget_progress_track"
        android:progressTint="@color/focus_haven_widget_accent" />

    <LinearLayout
        android:id="@+id/focus_haven_widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/focus_haven_widget_reset_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/focus_haven_widget_reset"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/focus_haven_widget_primary_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/focus_haven_widget_start"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
