<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_haven_wear_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:importantForAccessibility="no"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/focus_haven_wear_horizontal_padding"
        android:paddingTop="@dimen/focus_haven_wear_vertical_padding"
        android:paddingEnd="@dimen/focus_haven_wear_horizontal_padding"
        android:paddingBottom="@dimen/focus_haven_wear_vertical_padding">

        <LinearLayout
            android:id="@+id/focus_haven_wear_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:orientation="vertical">

            <TextView
                android:id="@+id/focus_haven_wear_session"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:textColor="@color/focus_haven_wear_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/focus_haven_wear_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:textColor="@color/focus_haven_wear_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/focus_haven_wear_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/focus_haven_wear_primary"
                android:textSize="34sp"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform" />

            <ProgressBar
                android:id="@+id/focus_haven_wear_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:progressBackgroundTint="@color/focus_haven_wear_track"
                android:progressTint="@color/focus_haven_wear_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/focus_haven_wear_command_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/focus_haven_wear_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/focus_haven_wear_primary_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/focus_haven_wear_accent"
            android:minHeight="48dp"
            android:maxLines="2"
            android:textAllCaps="false"
            android:textColor="@color/focus_haven_wear_button_text"
            android:visibility="gone" />

        <Button
            android:id="@+id/focus_haven_wear_secondary_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/focus_haven_wear_track"
            android:minHeight="48dp"
            android:maxLines="2"
            android:textAllCaps="false"
            android:textColor="@color/focus_haven_wear_primary"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="4"
            android:text="@string/private_controls_note"
            android:textColor="@color/focus_haven_wear_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
