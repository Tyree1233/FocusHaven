  "coachServiceBoundaryResponse": "Okay. I’ll stop here and give you space. No next step, no check-in, and nothing to prove. You can close Focus Coach now or come back whenever you choose.",
  "@coachServiceBoundaryResponse": {"description": "Deterministic local response honoring an explicit request to stop coaching."},
  "coachServiceRepairResponse": "Thank you for correcting me. I misunderstood what you needed, and I’m sorry. Let’s reset without making you repeat everything. What would fit better right now: listening without advice, gentle support, or a direct next step?",
  "@coachServiceRepairResponse": {"description": "Deterministic local repair response after the user says the coach misunderstood."},
  "coachServiceReflectionConflictResponse": "It sounds like two honest needs are pulling in different directions. Neither one has to be argued away yet. Which side feels harder to disappoint?",
  "@coachServiceReflectionConflictResponse": {"description": "Deterministic local reflective response for conflicting needs."},
  "coachServiceReflectionDefaultResponse": "Let’s slow this down. You do not need to turn it into a decision or an action plan yet. What part of this feels most important to understand first?",
  "@coachServiceReflectionDefaultResponse": {"description": "Default deterministic local reflective response."},
  "coachServiceReflectionFearFollowUp": "That fear sounds like it is carrying a lot of weight, even if another part of you knows what it wants. What is the fear trying to protect you from?",
  "@coachServiceReflectionFearFollowUp": {"description": "Deterministic local reflective follow-up for fear."},
  "coachServiceReflectionGuiltFollowUp": "You seem to be holding your own needs alongside concern for someone else. What would honoring yourself without dismissing them look like?",
  "@coachServiceReflectionGuiltFollowUp": {"description": "Deterministic local reflective follow-up for guilt or disappointment."},
  "coachServiceReflectionDefaultFollowUp": "There is something important in that, and we do not have to force it into a plan. Which part feels most true now that you have said it out loud?",
  "@coachServiceReflectionDefaultFollowUp": {"description": "Default deterministic local reflective follow-up."},
  "coachServiceReflectiveUncertaintyResponse": "Not knowing can be part of understanding this, rather than a problem to solve immediately. What feels uncertain underneath the decision itself?",
  "@coachServiceReflectiveUncertaintyResponse": {"description": "Deterministic local response to uncertainty during reflective coaching."},
  "coachServiceListeningRecognition": " It makes sense that {challenge} has been wearing on you.",
  "@coachServiceListeningRecognition": {"description": "Optional remembered-challenge fragment in the listening response.", "placeholders": {"challenge": {"type": "String", "example": "overwhelm"}}},
  "coachServiceListeningResponse": "Absolutely. You do not have to turn this into a plan or perform being okay for me.{recognition} Say as much or as little as you need. I’ll stay with you and listen without trying to fix it.",
  "@coachServiceListeningResponse": {"description": "Deterministic local response when the user asks for listening without advice.", "placeholders": {"recognition": {"type": "String", "example": " It makes sense that overwhelm has been wearing on you."}}},
  "coachServiceGentleRecognition": " I remember that {challenge} has been making this harder.",
  "@coachServiceGentleRecognition": {"description": "Optional remembered-challenge fragment in the gentle response.", "placeholders": {"challenge": {"type": "String", "example": "getting started"}}},
  "coachServiceGentleResponse": "Absolutely. I’ll keep this gentle.{recognition} You do not have to prove anything or solve “{task}” all at once. What would feel supportive right now: encouragement, a very small next step, or a moment to breathe?",
  "@coachServiceGentleResponse": {"description": "Deterministic local response when the user asks for gentle support.", "placeholders": {"recognition": {"type": "String", "example": " I remember that overwhelm has been making this harder."}, "task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceAccountabilityGoalMet": "Direct answer: you have already met today’s focus goal. The accountable choice may be to stop intentionally instead of turning rest into something you must earn twice. Close the session and protect tomorrow’s attention.",
  "@coachServiceAccountabilityGoalMet": {"description": "Direct local coaching response when today's focus goal is already met."},
