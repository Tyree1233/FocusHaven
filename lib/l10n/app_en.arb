  "@coachServiceAccountabilityQueueSingle": {"description": "Direct queue guidance when no additional queued items need mention."},
  "coachServiceAccountabilityResponse": "Direct version, without shame: commit to “{task}” for ten minutes. {queueDirection} {timerDirection} Do not negotiate with the whole project—do the next visible action, then check back honestly.",
  "@coachServiceAccountabilityResponse": {"description": "Deterministic local accountability response assembled from private context and stable guidance fragments.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}, "queueDirection": {"type": "String", "example": "Keep everything else out of view."}, "timerDirection": {"type": "String", "example": "Start one ten-minute focus round now."}}},
  "coachServiceUncertaintyListeningResponse": "You do not need to find the answer yet. I remember that you wanted listening without advice, so we can stay with the uncertainty. What feels most present when you say “I don’t know”?",
  "@coachServiceUncertaintyListeningResponse": {"description": "Deterministic local uncertainty response that preserves a prior request for listening."},
  "coachServiceUncertaintyDirectResponse": "You asked me to stay direct: do not solve the whole uncertainty. Choose one two-minute action on “{task},” do it now, and use what happens as the next piece of information.",
  "@coachServiceUncertaintyDirectResponse": {"description": "Deterministic local uncertainty response that preserves a prior request for directness.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceGentleOpening": "We can approach this gently. ",
  "@coachServiceGentleOpening": {"description": "Optional opening fragment that preserves a prior request for gentle support."},
  "coachServiceUncertaintyChallengeResponse": "{gentleOpening}Not knowing is allowed. Since {challenge} has been the obstacle, you do not need a perfect answer. Choose one: a real five-minute reset, or one two-minute action on “{task}.” Which feels more possible right now?",
  "@coachServiceUncertaintyChallengeResponse": {"description": "Deterministic local uncertainty response with a remembered challenge.", "placeholders": {"gentleOpening": {"type": "String", "example": "We can approach this gently. "}, "challenge": {"type": "String", "example": "overwhelm"}, "task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceUncertaintyDefaultResponse": "{gentleOpening}Not knowing is enough information to make the question smaller. For “{task},” which is closest: I need clarity, I need energy, or I’m afraid to begin? Pick the nearest answer—not the perfect one.",
  "@coachServiceUncertaintyDefaultResponse": {"description": "Default deterministic local uncertainty response.", "placeholders": {"gentleOpening": {"type": "String", "example": "We can approach this gently. "}, "task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceOverwhelmResponse": "That sounds like a lot to hold at once. Let’s make the next move smaller: open “{task}” and spend two minutes identifying the first visible action. You do not need to finish it—just make it easier to begin. Want to break it into three tiny steps together?",
  "@coachServiceOverwhelmResponse": {"description": "Deterministic local response to overwhelm.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceStartingRetryResponse": "You’re still here, so let’s change the experiment instead of repeating the same advice. For “{task},” spend sixty seconds only setting up—open it, put the needed item in front of you, and stop. Then choose: continue for two minutes, or tell me what blocked you.",
  "@coachServiceStartingRetryResponse": {"description": "Deterministic local second experiment after prior starting guidance did not help.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceStartingFirstResponse": "Let’s lower the stakes. For the next five minutes, your only job is to begin “{task}.” You may stop after five minutes if you want; starting is the win. What is the smallest physical action—open the file, write one line, or gather one item?",
  "@coachServiceStartingFirstResponse": {"description": "Deterministic local first response to difficulty starting.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceSetbackMemory": "We were already working with {challenge}, so this calls for a different experiment. ",
  "@coachServiceSetbackMemory": {"description": "Optional remembered-challenge fragment in the setback response.", "placeholders": {"challenge": {"type": "String", "example": "getting started"}}},
  "coachServiceSetbackResponse": "That’s frustrating, especially because you already made an effort. This is information, not proof that you failed. {memory}For “{task},” choose one reset: make the next step half as small, take a real five-minute break, or switch approaches. Which reset feels most honest right now?",
  "@coachServiceSetbackResponse": {"description": "Deterministic local response after a setback.", "placeholders": {"memory": {"type": "String", "example": "We were already working with overwhelm, so this calls for a different experiment. "}, "task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceSelfCriticismResponse": "I hear how hard you’re being on yourself. Struggling with “{task}” is a moment you’re having—not your identity. Let’s replace the verdict with one useful fact: what exactly is making the next step difficult—clarity, energy, or fear?",
  "@coachServiceSelfCriticismResponse": {"description": "Deterministic local response to self-criticism.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}}},
  "coachServicePerfectionismResponse": "It sounds like the standard has become so high that starting feels unsafe. Give yourself permission to make a rough version of “{task}” for ten minutes—something useful, not impressive. What would “good enough for this session” look like?",
  "@coachServicePerfectionismResponse": {"description": "Deterministic local response to perfectionism.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceDecisionQueueMultiple": "You have {count} items waiting, but only one needs your attention now.",
  "@coachServiceDecisionQueueMultiple": {"description": "Choice-overload queue fragment when multiple private items are waiting.", "placeholders": {"count": {"type": "int", "example": "3"}}},
  "coachServiceDecisionQueueSingle": "You only need to choose the next move, not the whole path.",
  "@coachServiceDecisionQueueSingle": {"description": "Choice-overload guidance when multiple queued items do not need mention."},
  "coachServiceDecisionResponse": "Too many reasonable options can freeze a decision. {queueNote} Choose “{task}” for one short trial round. A reversible choice does not need perfect certainty.",
  "@coachServiceDecisionResponse": {"description": "Deterministic local response to choice overload.", "placeholders": {"queueNote": {"type": "String", "example": "You only need to choose the next move, not the whole path."}, "task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceTimePressureResponse": "That time pressure is real, and panic can make the remaining time harder to use. For “{task},” name the smallest acceptable outcome, remove one nonessential piece, and work only on the next ten-minute block. What can safely be left out?",
  "@coachServiceTimePressureResponse": {"description": "Deterministic local response to time pressure.", "placeholders": {"task": {"type": "String", "example": "Review project notes"}}},
  "coachServiceFollowUpContinuingOpening": "Absolutely—let’s make the step we were discussing concrete.",
