  "coachServiceFollowUpNewOpening": "Absolutely—let’s make this concrete.",
  "@coachServiceFollowUpNewOpening": {"description": "Follow-up opening when no prior coach response exists."},
  "coachServiceFollowUpMemory": " Since {challenge} was the sticking point, we’ll keep each step deliberately small.",
